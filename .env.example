###############################################################################
# UYGULAMA
###############################################################################
APP_NAME=FLOWZA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

APP_MAINTENANCE_DRIVER=file

# Argon2id kullanilmadigi durumda bcrypt maliyeti (min. 12 onerilir).
BCRYPT_ROUNDS=12

###############################################################################
# LOG
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# VERITABANI (PostgreSQL)
###############################################################################
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saas
DB_USERNAME=saas
DB_PASSWORD=secret

###############################################################################
# REDIS  (cache + session + queue)
# Windows'ta phpredis eklentisi olmadigi icin saf PHP istemcisi "predis".
###############################################################################
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# null = cerez yalnizca kendi host'una gider; her tenant'in oturumu ayri kalir.
SESSION_DOMAIN=null
# Uretimde MUTLAKA true olmali: cerez yalnizca HTTPS uzerinden gonderilir.
# Yerelde http ile calisildigi icin false; true yapilirsa oturum acilmaz.
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
CACHE_PREFIX=saas_cache

QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

###############################################################################
# MAIL  (yerelde Mailpit -> http://localhost:8025)
###############################################################################
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@saas.local"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# MULTI-TENANCY
# Tenant'lar subdomain ile cozumlenir:  {tenant}.saas.local
# CENTRAL_DOMAINS = tenant'a ait OLMAYAN (yonetim/pazarlama) hostlar.
###############################################################################
# Yerelde hosts dosyasina dokunmadan calismak icin saas.localhost kullanin:
# tarayicilar *.localhost adreslerini kendiliginden 127.0.0.1e cozer.
# saas.local tercih edilirse hosts dosyasina kayit gerekir (yonetici izni).
TENANCY_BASE_DOMAIN=saas.localhost
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,saas.localhost

# Tenant kapsamli bir model, tenant baglami olmadan sorgulanirsa istisna firlatsin mi?
TENANCY_STRICT=true

###############################################################################
# ODEME / ABONELIK
# Su an gercek saglayici yok; "manual" surucu havale/elden onay akisini calistirir.
# Ileride: iyzico | stripe
###############################################################################
BILLING_GATEWAY=manual
BILLING_CURRENCY=TRY
BILLING_TRIAL_DAYS=14

###############################################################################
# VITE
###############################################################################
VITE_APP_NAME="${APP_NAME}"

###############################################################################
# YEDEKLEME
# Sunucuda PostgreSQL istemcisi varsa: BACKUP_DUMP_COMMAND=pg_dump
# Yerelde veritabani konteynerde ise asagidaki gibi konteynere yonlendirin.
###############################################################################
BACKUP_DUMP_COMMAND="docker exec -i -e PGPASSWORD saas_postgres pg_dump"
BACKUP_KEEP_DAYS=14
# BACKUP_PATH=/var/yedek
